[{"description":"The essential Linux commands for navigating the system, managing files, permissions, users, processes, and basic networking.","sections":[{"heading":"Navigation","rows":[{"command":"pwd","description":"Show your current directory path"},{"command":"ls -la","description":"List all files including hidden ones"},{"command":"cd <dir>","description":"Move into a directory"},{"command":"cd ..","description":"Move up one directory level"},{"command":"cd ~","description":"Jump back to your home directory"},{"command":"find / -name \"*.conf\" 2>/dev/null","description":"Search the filesystem by filename"}]},{"heading":"Files and Directories","rows":[{"command":"touch file.txt","description":"Create an empty file"},{"command":"mkdir -p dir/subdir","description":"Create nested directories at once"},{"command":"cp -r src dst","description":"Copy files or directories recursively"},{"command":"mv old new","description":"Move or rename a file"},{"command":"rm -rf dir","description":"Delete a directory and contents"},{"command":"cat file.txt","description":"Print a whole file to terminal"},{"command":"less file.txt","description":"Scroll through a file page by page"},{"command":"head -n 20 file.txt","description":"Show the first 20 lines"},{"command":"tail -n 20 file.txt","description":"Show the last 20 lines"},{"command":"tail -f /var/log/auth.log","description":"Follow a log file live"},{"command":"grep -ri \"password\" /etc","description":"Search file contents for a word"},{"command":"wc -l file.txt","description":"Count lines in a file"}]},{"heading":"Permissions and Users","rows":[{"command":"chmod 755 script.sh","description":"Set owner rwx, others read and execute"},{"command":"chmod +x script.sh","description":"Make a file executable"},{"command":"chown user:group file","description":"Change file owner and group"},{"command":"whoami","description":"Show your current username"},{"command":"id","description":"Show your user and group IDs"},{"command":"sudo -l","description":"List commands you can run as root"},{"command":"sudo su -","description":"Switch to a root shell"}]},{"heading":"Processes and System","rows":[{"command":"ps aux | grep ssh","description":"List running processes matching ssh"},{"command":"top","description":"Live view of running processes"},{"command":"htop","description":"Friendlier interactive process viewer"},{"command":"kill -9 <PID>","description":"Force kill a process by ID"},{"command":"df -h","description":"Show disk space in readable units"},{"command":"free -h","description":"Show memory and swap usage"},{"command":"uname -a","description":"Show kernel and system info"},{"command":"uptime","description":"Show how long the system runs"}]},{"heading":"Networking Basics","rows":[{"command":"ip a","description":"Show all network interfaces and addresses"},{"command":"ss -tuln","description":"List listening TCP and UDP ports"},{"command":"ping -c 4 8.8.8.8","description":"Send 4 ping packets to test connectivity"},{"command":"curl -I https://example.com","description":"Fetch only HTTP response headers"}]}],"slug":"linux-basics","title":"Linux Basics"},{"description":"Commands for testing connectivity, inspecting ports and DNS, and scanning hosts during reconnaissance.","sections":[{"heading":"Connectivity","rows":[{"command":"ping -c 4 target.com","description":"Send 4 pings to check reachability"},{"command":"traceroute target.com","description":"Trace the route packets take"},{"command":"mtr target.com","description":"Combined ping and traceroute, live"},{"command":"curl -I https://target.com","description":"Show only the HTTP response headers"},{"command":"curl -s -L https://target.com","description":"Follow redirects silently, show body"},{"command":"curl -X POST -d \"a=1\" https://target.com/api","description":"Send a POST request with data"},{"command":"wget https://target.com/file.zip","description":"Download a file over HTTP"}]},{"heading":"Ports and Sockets","rows":[{"command":"ss -tuln","description":"List listening TCP and UDP ports"},{"command":"ss -tupn","description":"Show processes using each TCP socket"},{"command":"netstat -tuln","description":"Older tool listing listening ports"},{"command":"nc -zv target.com 1-1000","description":"Scan TCP ports 1 to 1000"},{"command":"nc -lvnp 4444","description":"Listen on port 4444 for connections"}]},{"heading":"DNS","rows":[{"command":"dig target.com","description":"Query DNS records for a domain"},{"command":"dig target.com ANY +short","description":"Get all record types, short output"},{"command":"dig -x 93.184.216.34","description":"Reverse lookup an IP address"},{"command":"nslookup target.com","description":"Simple DNS lookup with defaults"},{"command":"host target.com","description":"Quick DNS lookup, one line answer"}]},{"heading":"Nmap Essentials","rows":[{"command":"nmap target.com","description":"Scan the top 1000 TCP ports"},{"command":"nmap -sV target.com","description":"Detect service versions on open ports"},{"command":"nmap -sC target.com","description":"Run default NSE scripts on targets"},{"command":"nmap -p- target.com","description":"Scan all 65535 TCP ports"},{"command":"nmap -A target.com","description":"Aggressive scan: OS, versions, scripts"},{"command":"nmap -sn 192.168.1.0/24","description":"Ping sweep to find live hosts"},{"command":"nmap -sU --top-ports 50 target.com","description":"Scan the top 50 UDP ports"},{"command":"nmap -oN scan.txt target.com","description":"Save normal scan output to file"}]}],"slug":"networking-commands","title":"Networking and Recon"},{"description":"Practical commands for web application testing: directory discovery, fingerprinting, scanning, and SQL injection testing.","sections":[{"heading":"Directory and Content Discovery","rows":[{"command":"ffuf -u https://target.com/FUZZ -w wordlist.txt","description":"Fuzz paths on the web root"},{"command":"ffuf -u https://target.com/FUZZ -w wordlist.txt -e .php,.bak,.txt","description":"Fuzz paths with file extensions"},{"command":"ffuf -u https://target.com/FUZZ -w wordlist.txt -fc 404","description":"Hide 404 responses in results"},{"command":"gobuster dir -u https://target.com -w wordlist.txt","description":"Brute force directories and files"},{"command":"gobuster dir -u https://target.com -w wordlist.txt -x php,txt,bak","description":"Brute force with extra extensions"},{"command":"gobuster dns -d target.com -w subdomains.txt","description":"Brute force subdomains via DNS"}]},{"heading":"Fingerprinting","rows":[{"command":"whatweb https://target.com","description":"Identify tech stack of a site"},{"command":"whatweb -v https://target.com","description":"Verbose fingerprint with plugin detail"},{"command":"curl -I https://target.com","description":"Inspect server and security headers"},{"command":"nikto -h https://target.com","description":"Scan for known web misconfigurations"}]},{"heading":"SQL Injection Testing","rows":[{"command":"sqlmap -u \"https://target.com/page?id=1\"","description":"Test a URL parameter for SQLi"},{"command":"sqlmap -u \"https://target.com/page?id=1\" --dbs","description":"Enumerate databases after injection found"},{"command":"sqlmap -u \"https://target.com/page?id=1\" -D db --tables","description":"List tables inside one database"},{"command":"sqlmap -r request.txt --batch","description":"Test a saved request file automatically"},{"command":"sqlmap -u \"https://target.com/page?id=1\" --level 3 --risk 2","description":"Deeper tests with more payloads"}]},{"heading":"Parameter and Header Fuzzing","rows":[{"command":"ffuf -u \"https://target.com/page?FUZZ=1\" -w params.txt","description":"Fuzz parameter names on an endpoint"},{"command":"ffuf -u https://target.com/ -w wordlist.txt -H \"X-FUZZ: test\"","description":"Fuzz a custom HTTP header value"},{"command":"curl -s \"https://target.com/page?id=1'\" | head -c 500","description":"Test for error based SQLi quickly"},{"command":"gobuster vhost -u https://target.com -w subdomains.txt","description":"Brute force virtual hosts on one IP"},{"command":"ffuf -u https://target.com/FUZZ -w wordlist.txt -mc 200,301,403","description":"Show only chosen status codes"}]}],"slug":"web-pentest","title":"Web Pentest Workflow"},{"description":"Commands for Windows enumeration and Active Directory recon, from PowerShell basics to domain queries.","sections":[{"heading":"PowerShell Essentials","rows":[{"command":"Get-ChildItem -Recurse C:\\Users","description":"List files recursively under Users"},{"command":"Get-Process | Where-Object {$_.CPU -gt 100}","description":"Show processes using lots of CPU"},{"command":"Get-Service | Where-Object {$_.Status -eq 'Running'}","description":"List all running services"},{"command":"Test-NetConnection target.com -Port 445","description":"Test if a TCP port is open"},{"command":"Get-LocalUser","description":"List local user accounts"},{"command":"Get-LocalGroupMember Administrators","description":"List local admin group members"},{"command":"Invoke-WebRequest -Uri https://example.com/f -OutFile f.exe","description":"Download a file with PowerShell"}]},{"heading":"Local Enumeration","rows":[{"command":"whoami /all","description":"Show user, groups, and privileges"},{"command":"net user","description":"List local user accounts"},{"command":"net localgroup administrators","description":"List local administrators"},{"command":"net user <username> /domain","description":"Show details of a domain user"},{"command":"systeminfo","description":"Show OS, patches, and uptime"},{"command":"ipconfig /all","description":"Show full network configuration"}]},{"heading":"Domain Recon","rows":[{"command":"net group \"Domain Admins\" /domain","description":"List domain admin members"},{"command":"net group /domain","description":"List all groups in the domain"},{"command":"nltest /domain_trusts","description":"Show trusts between domains"},{"command":"nltest /dclist:domain.local","description":"Find domain controllers for a domain"},{"command":"setspn -Q */*","description":"List service principal names in AD"},{"command":"Get-ADUser -Filter * -Properties *","description":"Dump all domain user objects"},{"command":"Get-ADComputer -Filter *","description":"List all computers in the domain"}]},{"heading":"Remote Access and Ticket Tools","rows":[{"command":"evil-winrm -i 10.10.10.10 -u user -p 'pass'","description":"Open a WinRM shell on a target"},{"command":"evil-winrm -i 10.10.10.10 -u user -H <nthash>","description":"WinRM shell using a password hash"},{"command":"Rubeus.exe asktgt /user:user /password:pass /domain:dom.local","description":"Request a Kerberos TGT ticket"},{"command":"Rubeus.exe asktgs /service:cifs/dc.dom.local /ptt","description":"Request a service ticket, inject it"},{"command":"Rubeus.exe kerberoast","description":"Request crackable Kerberos service tickets"}]}],"slug":"windows-ad","title":"Windows and Active Directory"},{"description":"The git commands students actually use daily: cloning, committing, branching, syncing, and fixing mistakes.","sections":[{"heading":"Getting Started","rows":[{"command":"git clone https://github.com/user/repo.git","description":"Copy a remote repo to your machine"},{"command":"git init","description":"Start a new repo in a folder"},{"command":"git status","description":"Show changed and untracked files"}]},{"heading":"Saving Changes","rows":[{"command":"git add .","description":"Stage all changes for commit"},{"command":"git add file.txt","description":"Stage one specific file"},{"command":"git commit -m \"message\"","description":"Save staged changes with a message"},{"command":"git commit -am \"message\"","description":"Stage tracked files and commit together"},{"command":"git diff","description":"Show unstaged changes line by line"},{"command":"git diff --staged","description":"Show staged changes before committing"}]},{"heading":"Syncing with Remote","rows":[{"command":"git push origin main","description":"Upload commits to the remote main branch"},{"command":"git pull","description":"Fetch and merge remote changes"},{"command":"git fetch","description":"Download remote changes without merging"},{"command":"git remote -v","description":"Show configured remote URLs"}]},{"heading":"Branches","rows":[{"command":"git branch","description":"List local branches"},{"command":"git checkout -b feature","description":"Create and switch to a branch"},{"command":"git switch feature","description":"Switch to an existing branch"},{"command":"git merge feature","description":"Merge a branch into the current one"},{"command":"git branch -d feature","description":"Delete a merged branch"}]},{"heading":"History and Undo","rows":[{"command":"git log --oneline -10","description":"Show last 10 commits, one per line"},{"command":"git stash","description":"Shelve changes to switch context cleanly"},{"command":"git stash pop","description":"Restore the most recent stash"},{"command":"git checkout -- file.txt","description":"Discard unstaged changes in a file"},{"command":"git reset HEAD file.txt","description":"Unstage a file, keep its changes"}]},{"heading":"Simple Conflicts","rows":[{"command":"git pull origin main","description":"Pull first when push is rejected"},{"command":"git status","description":"See which files have conflicts"},{"command":"git mergetool","description":"Open a visual merge tool for conflicts"},{"command":"git add file.txt && git commit","description":"Mark conflict resolved and commit"},{"command":"git merge --abort","description":"Cancel the merge and start over"}]}],"slug":"git-essentials","title":"Git Essentials"},{"description":"Bash scripting building blocks: variables, conditionals, loops, functions, and one-liners you can reuse.","sections":[{"heading":"Variables","rows":[{"command":"name=\"izaz\"","description":"Assign a string to a variable"},{"command":"echo \"Hello $name\"","description":"Print text with variable expansion"},{"command":"read -p \"Target: \" target","description":"Prompt and read user input"},{"command":"count=$((count + 1))","description":"Do arithmetic on a variable"}]},{"heading":"Conditionals","rows":[{"command":"if [ -f file.txt ]; then echo \"exists\"; fi","description":"Run code if a file exists"},{"command":"if [ \"$a\" = \"$b\" ]; then echo \"equal\"; fi","description":"Compare two strings for equality"},{"command":"if [ $n -gt 10 ]; then echo \"big\"; fi","description":"Compare numbers, greater than"},{"command":"[ -d dir ] && echo \"is dir\"","description":"Short test that a path is a directory"}]},{"heading":"Loops","rows":[{"command":"for i in {1..10}; do echo $i; done","description":"Loop numbers 1 through 10"},{"command":"for f in *.txt; do cat \"$f\"; done","description":"Loop over every txt file"},{"command":"while read line; do echo \"$line\"; done < file.txt","description":"Read a file line by line"},{"command":"for ip in 192.168.1.{1..254}; do ping -c1 -W1 $ip & done","description":"Ping sweep a subnet in parallel"}]},{"heading":"Functions","rows":[{"command":"greet() { echo \"Hi $1\"; }","description":"Define a function taking one argument"},{"command":"greet izaz","description":"Call a function with an argument"},{"command":"scan() { nmap -sV \"$1\"; }","description":"Wrap nmap in a reusable function"},{"command":"return 0","description":"Exit a function with success status"}]},{"heading":"Useful One-Liners","rows":[{"command":"grep -r \"TODO\" . --include=\"*.py\"","description":"Find TODO comments in Python files"},{"command":"find . -name \"*.log\" -delete","description":"Delete all log files recursively"},{"command":"ps aux | sort -nrk 3 | head -5","description":"Show the 5 most CPU hungry processes"},{"command":"history | awk '{print $2}' | sort | uniq -c | sort -nr | head","description":"Rank your most used commands"},{"command":"tar -czf backup.tar.gz dir/","description":"Compress a directory into a tarball"},{"command":"chmod +x script.sh && ./script.sh","description":"Make executable and run a script"}]}],"slug":"bash-scripting","title":"Bash Scripting"}]